PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Demo login password. Change before a private pilot.
DEMO_PASSWORD=Pilot-only-2026!
# Optional real server-side AI. Never put keys in public/.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
REPORT_MODEL=gpt-4o-mini
# Set true only behind HTTPS
COOKIE_SECURE=false
# Hosted deployment: pooled Neon connection. Leave empty for local SQLite.
DATABASE_URL=
DATABASE_SCHEMA=public
# Private Vercel Blob store token; never use a public store for guard media.
BLOB_READ_WRITE_TOKEN=
# Stable random secret, minimum 32 random bytes, configured in Vercel secrets.
MEDIA_SIGNING_SECRET=
# Only for explicitly seeding a new demo database during db:migrate.
SEED_DEMO=false
# In-app messaging is excluded from MVP. Enable only for a future release.
ENABLE_MESSAGING=false
# Public support contact shown in the customer notice and required for signup.
# Use an ISDL-managed email address, telephone number, or WhatsApp contact.
PILOT_SUPPORT_CONTACT=
